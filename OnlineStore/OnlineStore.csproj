<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cs308-onlinestore-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <!-- Pomelo 8.0.3 allows MySqlConnector 2.3.5 or later; 2.6.1 is the first version with the fix for GHSA-473q-m89c-ghf8. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>

  <!-- Backend builds/tests stay independent of Node. Publish builds and packages the locked React app. -->
  <Target Name="PublishReact" BeforeTargets="ComputeFilesToPublish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../frontend" Command="npm ci" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../frontend" Command="npm run build" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../frontend/dist/index.html')" Text="React dist/index.html is missing. Build frontend before using SkipFrontendBuild." />
    <ItemGroup>
      <_ReactDist Include="$(MSBuildProjectDirectory)/../frontend/dist/**/*" />
      <ResolvedFileToPublish Include="@(_ReactDist)">
        <RelativePath>wwwroot/spa/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
